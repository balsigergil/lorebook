# Copy to .env and adapt. Every setting is read from the environment.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=.localhost,127.0.0.1,[::1],host.docker.internal
# Behind a reverse proxy terminating TLS:
# DJANGO_BEHIND_PROXY=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://docs.example.com,https://kb.example.com
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Share the session between portals on sibling domains:
# DJANGO_SESSION_COOKIE_DOMAIN=.example.com
LOREBOOK_HTTP_PROTOCOL=http
LOREBOOK_TIME_ZONE=Europe/Zurich

DB_NAME=lorebook
DB_USER=lorebook
DB_PASSWORD=lorebook
DB_HOST=127.0.0.1
DB_PORT=5432

EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL="Lorebook <lorebook@localhost>"

# Media files: local (default) or s3
LOREBOOK_MEDIA_STORAGE=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET_NAME=lorebook-media
# S3_ACCESS_KEY_ID=lorebook
# S3_SECRET_ACCESS_KEY=lorebooklore
# S3_REGION_NAME=us-east-1

# Generic OpenID Connect (Google Workspace, Microsoft Entra, Keycloak…).
# Callback URL: <site>/accounts/oidc/<OIDC_PROVIDER_ID>/login/callback/
# OIDC_PROVIDER_ID=sso
# OIDC_NAME=Company SSO
# OIDC_SERVER_URL=https://login.example.com/realms/acme
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Let anyone from the identity provider sign in without an invitation:
# OIDC_ALLOW_SIGNUP=false

# Development only: assets from the Vite dev server (npm run dev).
LOREBOOK_VITE_DEV=true
